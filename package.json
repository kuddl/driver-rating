{
  "name": "driver-rating",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "npm run db:local && nuxt dev",
    "dev:lan": "npm run db:local && nuxt dev --host 0.0.0.0 --port 3000",
    "db:local": "wrangler d1 migrations apply driver-rating-db --local",
    "deploy": "npm run build && wrangler deploy",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "dev:cf": "nuxt build && wrangler dev --port 8787"
  },
  "dependencies": {
    "nuxt": "^4.6.4",
    "qrcode": "1.5.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  }
}
